<?xml version="1.0" encoding="utf-8"?>
<!--
  Wide (4x2) widget: what's still open today.

  Fixed row slots rather than a ListView/RemoteViewsService: at four visible rows
  a collection adapter is a lot of moving parts for no benefit, and fixed slots
  let each row carry its own PendingIntent for one-tap completion.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/widget_header">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="PERSONAL OPS"
            android:textColor="#FFCC00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/widget_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C8102E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      LinearLayout used as a colored divider bar rather than a plain View element:
      RemoteViews only supports a fixed whitelist of view classes (FrameLayout,
      LinearLayout, RelativeLayout, TextView, ImageView, Button, ProgressBar, and a
      few others) and plain android.view.View is not on it.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#FFCC00"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALL CLEAR"
        android:textColor="#4ADE80"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:paddingTop="10dp" />

    <!--
      Each row is a horizontal strip: a thin yellow accent bar, then the row
      text. This mirrors the app's own card treatment (a colored left edge on
      directive rows), rather than a bare TextView with no visual structure at
      all, which is what every row was before this.
    -->
    <LinearLayout
        android:id="@+id/widget_row_0_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#FFCC00" />
        <TextView
            android:id="@+id/widget_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E8EA"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_1_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#FFCC00" />
        <TextView
            android:id="@+id/widget_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E8EA"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#FFCC00" />
        <TextView
            android:id="@+id/widget_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E8EA"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#FFCC00" />
        <TextView
            android:id="@+id/widget_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E8EA"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#7A7A80"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
